__pycache__/
*.py[cod]
axiom_engine_rs/target/
# Isolated test target dir (avoids relink contention with the running proxy/MCP binary)
axiom_engine_rs/target-test/

# Model checkpoints are generated artifacts, never committed. `axiom init` /
# eval bootstrap a local checkpoint into the CWD when no model can be fetched,
# so ignore *.safetensors anywhere (incl. the repo root), not just the crate dir.
*.safetensors
axiom_engine_rs/checkpoints/
checkpoints/
*.bin
target/

# Runtime logs (generated by start_axiom.sh and test scripts)
*.log
logs/*.json

# Persistent vibe memory + its backups (runtime artifacts; reset via scripts/axiom-wipe.sh)
axiom_master_vibe.bin
.vibe_backups/

# Deployed release tag recorded by scripts/update_axiom.ps1 (runtime state)
.axiom_release_version
bench/results/*.json

# Temp files from CI debugging
tmp_*.txt
bench/cvm/pss-eval-logs-*/
C\xef\x80\xbaWINDOWSTEMP*
